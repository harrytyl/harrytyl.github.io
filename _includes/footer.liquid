{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center.liquid %}
      {% else %}
        {% include newsletter.liquid %}
      {% endif %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}

{% comment %}
  Local override of al_folio_core's _includes/footer.liquid: identical to the
  gem template above, plus the visitor tracker below.

  footer.liquid is included unconditionally by default.liquid, so putting the
  tracker here counts a visit on every page of the site rather than only on the
  about page. Requesting the image is what registers the visit; it is kept
  1px and off-screen (rather than display:none, which lets browsers skip the
  request) so nothing is drawn. Read the numbers at
  https://mapmyvisitors.com/web/{{ site.visitor_map.web_id }}. Blank
  visitor_map.tracker_id in _config.yml to switch tracking off.
{% endcomment %}
{% if site.visitor_map.tracker_id %}
  <img
    src="https://mapmyvisitors.com/map.png?cl=080808&w=500&t=tt&d={{ site.visitor_map.tracker_id }}&co=ffffff&ct=808080"
    alt=""
    aria-hidden="true"
    width="1"
    height="1"
    style="position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; pointer-events: none;"
  >
{% endif %}
